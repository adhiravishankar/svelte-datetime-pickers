{
  "name": "svelte-fit-action",
  "version": "0.1.0",
  "description": "Svelte actions that keep popups inside the viewport (fit) and render them elsewhere in the DOM (portal).",
  "keywords": [
    "fit",
    "popup",
    "portal",
    "svelte",
    "svelte-action"
  ],
  "license": "MIT",
  "author": {
    "name": "Adhi Ravishankar",
    "email": "adhiravishankar@gmail.com"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "clean": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "format": "vp fmt --check",
    "lint": "vp lint",
    "prepack": "npm run clean && npm run build",
    "test": "npm run lint && npm run tsc && npm run format && npm run unit",
    "tsc": "tsc",
    "unit": "vp test",
    "watch": "svelte-package --input src --output dist --watch"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.1",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
