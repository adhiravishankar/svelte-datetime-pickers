{
  "name": "svelte-datetime-input",
  "version": "0.1.0",
  "description": "Segmented datetime input fields for your Svelte app.",
  "keywords": [
    "date",
    "datetime",
    "datetime-input",
    "input",
    "svelte",
    "time"
  ],
  "license": "MIT",
  "author": {
    "name": "Adhi Ravishankar",
    "email": "adhiravishankar@gmail.com"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*.css": "./dist/*.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "clean": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "format": "vp fmt --check",
    "lint": "vp lint",
    "prepack": "npm run clean && npm run build",
    "test": "npm run lint && npm run tsc && npm run format && npm run unit",
    "tsc": "svelte-check --tsconfig ./tsconfig.json",
    "unit": "vp test",
    "watch": "svelte-package --input src --output dist --watch"
  },
  "dependencies": {
    "svelte-date-input": "^0.1.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
