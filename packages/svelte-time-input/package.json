{
  "name": "svelte-time-input",
  "version": "0.1.0",
  "description": "Segmented time input fields for your Svelte app.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*.css": "./dist/*.css"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "clean": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "format": "biome format",
    "lint": "biome lint",
    "prepack": "yarn clean && yarn build",
    "test": "yarn lint && yarn tsc && yarn format && yarn unit",
    "tsc": "svelte-check --tsconfig ./tsconfig.json",
    "unit": "vitest",
    "watch": "svelte-package --input src --output dist --watch"
  },
  "keywords": [
    "input",
    "svelte",
    "time",
    "time-input"
  ],
  "license": "MIT",
  "dependencies": {
    "svelte-date-input": "workspace:^"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.60.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/*.spec.*"
  ]
}
