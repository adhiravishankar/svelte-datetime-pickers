{
  "name": "svelte-datetimerange-picker-monorepo",
  "version": "1.0.0",
  "description": "svelte-datetimerange-picker monorepo",
  "author": {
    "name": "Adhi Ravishankar",
    "email": "adhiravishankar@gmail.com"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "test"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological --exclude test run build",
    "dev": "yarn workspaces foreach --all --parallel --interlaced --exclude test run watch & yarn workspace test dev",
    "format": "yarn workspaces foreach --all run format",
    "lint": "yarn workspaces foreach --all run lint",
    "postinstall": "husky",
    "test": "yarn workspaces foreach --all run test",
    "tsc": "yarn workspaces foreach --all run tsc",
    "unit": "yarn workspaces foreach --all run unit"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "vite-plus": "1.4.0"
  },
  "packageManager": "yarn@4.17.1",
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
